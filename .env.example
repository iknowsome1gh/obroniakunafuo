# Public site URL (used for metadata, sitemap and absolute links)
NEXT_PUBLIC_SITE_URL=https://obroniakunafuo.org

# Optional analytics
# Plausible domain (e.g. obroniakunafuo.org). Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Admin sign-in
# Password-based mock auth is available in local development only. Production
# builds require Supabase credentials below, so admin stays locked until then.
ADMIN_PASSWORD=oak-admin

# Supabase (optional)
# When both values are present, admin sign-in and content storage switch to
# Supabase. Without them the site uses the in-memory demo store.
NEXT_PUBLIC_SUPABASE_URL=https://xamhmrcuqghwjeiilqpt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase key (required for production writes)
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Obroni Akunafo Kuo <noreply@obroniakunafuo.org>
ADMIN_NOTIFICATION_EMAIL=obroniakunafuo@gmail.com
